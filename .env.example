# ----------------------------
# Zero-budget deployment policy
# ----------------------------
STRICT_ZERO_BUDGET=true
LLM_PROVIDER_MODE=oss_only
ALLOW_PAID_FALLBACK=false
ALLOW_PAID_LLM=false

# ----------------------------
# Backend LLM runtime (Ollama-only)
# ----------------------------
LLM_RUNTIME_PROVIDER=ollama
TOJI_FORCE_OLLAMA=1

# Ollama cloud API
OLLAMA_BASE_URL=https://ollama.com
OLLAMA_MODEL=gpt-oss:120b-cloud
OLLAMA_API_KEY=
OLLAMA_AUTH_HEADER=Authorization
OLLAMA_TIMEOUT_SEC=90
OLLAMA_CHAT_NUM_PREDICT=4096
OLLAMA_DISABLE_THINKING=1
OLLAMA_EMPTY_CONTENT_RETRY=1
OLLAMA_CLOUD_ALIAS_FALLBACK=0
TOJI_INTAKE_FAST_MODE=1
TOJI_OLLAMA_CLOUD_ONLY=1
TOJI_OLLAMA_ALLOW_LOCAL_WITH_KEY=0

# Optional local Ollama (only used when TOJI_OLLAMA_CLOUD_ONLY=0)
OLLAMA_HOST=http://localhost:11434
LLM_RUNTIME_LOCAL_ONLY=0

# ----------------------------
# Pipeline settings
# ----------------------------
INDUSTRY=ecommerce
MAX_ROWS=200000
MIN_MATCH_SCORE=0.80
TOJI_UNIFIED_FLOW=1
ENABLE_LEGACY_ROUTER=0

# ----------------------------
# Backend runtime
# ----------------------------
# Set a long random value before deploying outside local development.
BACKEND_SESSION_SECRET=replace_me
BACKEND_TASK_WORKERS=2
# Comma-separated frontend origins. Avoid "*" in production.
BACKEND_CORS_ORIGINS=http://localhost:8080
SESSION_TTL_HOURS=1
SESSION_COOLDOWN_HOURS=24

# ----------------------------
# Runtime safeguards
# ----------------------------
RATE_UPLOAD_LIMIT=20
RATE_UPLOAD_WINDOW_SEC=600
RATE_TELLUS_LIMIT=40
RATE_TELLUS_WINDOW_SEC=3600
RATE_PREDICT_LIMIT=12
RATE_PREDICT_WINDOW_SEC=3600
RATE_CHAT_LIMIT=60
RATE_CHAT_WINDOW_SEC=3600

RETENTION_SWEEP_INTERVAL_SEC=900
RUNTIME_ARTIFACT_TTL_HOURS=168
CHAT_TTL_HOURS=168
REPORT_TTL_HOURS=336
INTAKE_TTL_HOURS=72
STATE_TTL_HOURS=72
DEBUG_TTL_HOURS=48
